{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Plain PDF",
  "version": "1.3.1",
  "identifier": "io.github.rthapaliya19.plainpdf",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Plain PDF",
        "width": 1200,
        "height": 860,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost blob: data:; img-src 'self' blob: data:; font-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A private, offline PDF viewer and editor",
    "longDescription": "View, draw, highlight, type, sign, fill forms, organize and save PDFs. Works fully offline; files never leave your device.",
    "copyright": "Copyright (c) 2026 rthapaliya19. MIT License.",
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "description": "PDF document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}

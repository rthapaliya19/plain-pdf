{
  "name": "plain-pdf",
  "private": true,
  "version": "1.0.0",
  "description": "A private, offline, uncluttered PDF viewer with pen, highlighter and signature tools.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/arimo": "5.3.0",
    "@fontsource/cousine": "5.3.0",
    "@fontsource/tinos": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-fs": "2.7.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
